{
  "name": "nightly-chrono-cipher",
  "version": "1.0.0",
  "description": "Time-based encryption CLI tool for creating messages that can only be decrypted at specific future timestamps",
  "main": "dist/index.js",
  "bin": {
    "nightly-chrono-cipher": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "encryption",
    "time-based",
    "cli",
    "typescript",
    "time-lock",
    "chrono",
    "cipher"
  ],
  "author": "ApocalypsAI",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.0.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.ts"
    ]
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
