{
  "name": "nightly-quantum-entanglement-checker",
  "version": "1.0.0",
  "description": "A whimsical TypeScript CLI tool that simulates quantum entanglement verification for distributed systems",
  "main": "dist/index.js",
  "bin": {
    "quantum-entangle": "dist/main.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "test:watch": "jest --watch",
    "start": "ts-node src/main.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "quantum",
    "entanglement",
    "cli",
    "typescript",
    "distributed-systems",
    "whimsical"
  ],
  "author": "ApocalypsAI",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "commander": "^11.0.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": ["**/*.test.ts"]
  }
}
