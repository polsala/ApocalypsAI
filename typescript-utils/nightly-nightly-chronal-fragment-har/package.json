{
  "name": "nightly-chronal-fragment-harmonizer",
  "version": "1.0.0",
  "description": "A TypeScript CLI tool to sort and categorize temporal data fragments based on distortion and timestamp, generating a harmonization report.",
  "main": "dist/cli.js",
  "types": "dist/cli.d.ts",
  "bin": {
    "harmonize-fragments": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "ts-node src/cli.ts",
    "test": "jest",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "keywords": [
    "apocalypsai",
    "cli",
    "typescript",
    "data",
    "temporal",
    "harmonizer"
  ],
  "author": "ApocalypsAI",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.12.7",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
