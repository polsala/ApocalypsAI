{
  "name": "nightly-quantum-entanglement-checker",
  "version": "1.0.0",
  "description": "A whimsical utility that checks if two pieces of code are 'quantum entangled'",
  "main": "dist/main.js",
  "bin": {
    "quantum-entanglement": "dist/main.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "lint": "eslint src/**/*.ts tests/**/*.ts",
    "start": "node dist/main.js",
    "dev": "ts-node src/main.ts"
  },
  "keywords": [
    "quantum",
    "entanglement",
    "code-analysis",
    "typescript",
    "cli",
    "whimsical"
  ],
  "author": "ApocalypsAI",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^18.0.0",
    "@typescript-eslint/eslint-plugin": "^5.0.0",
    "@typescript-eslint/parser": "^5.0.0",
    "eslint": "^8.0.0",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.0",
    "typescript": "^4.9.0"
  },
  "dependencies": {
    "commander": "^11.0.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.ts"
    ]
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
