{
  "name": "nightly-quantum-entanglement-checker",
  "version": "1.0.0",
  "description": "A whimsical-yet-useful TypeScript utility that detects quantum entanglement patterns in code",
  "main": "dist/main.js",
  "types": "dist/main.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "test:watch": "jest --watch",
    "analyze": "ts-node src/main.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "quantum",
    "entanglement",
    "typescript",
    "static-analysis",
    "linting",
    "code-quality"
  ],
  "author": "ApocalypsAI",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": ["**/tests/**/*.ts"]
  },
  "bin": {
    "nightly-quantum-entanglement-checker": "dist/main.js"
  }
}
