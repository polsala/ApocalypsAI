{
  "name": "nightly-quantum-entanglement-checker",
  "version": "1.0.0",
  "description": "A whimsical-yet-practical TypeScript CLI tool that simulates quantum entanglement verification for distributed systems using type-safe probabilistic algorithms",
  "main": "dist/main.js",
  "types": "dist/main.d.ts",
  "bin": {
    "nightly-quantum-entanglement-checker": "dist/main.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "start": "ts-node src/main.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "quantum",
    "entanglement",
    "cli",
    "typescript",
    "bell-inequality",
    "chsh",
    "quantum-computing",
    "education"
  ],
  "author": "ApocalypsAI",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^5.57.0",
    "@typescript-eslint/parser": "^5.57.0",
    "eslint": "^8.37.0",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.0.0"
  },
  "dependencies": {},
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/*.test.ts"
    ],
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/*.d.ts",
      "!src/main.ts"
    ]
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
