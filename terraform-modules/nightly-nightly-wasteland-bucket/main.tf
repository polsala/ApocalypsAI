terraform {\n  required_providers {\n    aws = {\n      source  = "hashicorp/aws"\n      version = "~> 5.0"\n    }\n  }\n}\n\nprovider "aws" {\n  # In test environment we use dummy credentials; real usage requires proper AWS config.\n  region = var.aws_region\n}\n\nresource "aws_s3_bucket" "safehouse" {\n  bucket = var.bucket_name\n\n  versioning {\n    enabled = true\n  }\n\n  lifecycle_rule {\n    id      = "expire-old-versions"\n    enabled = true\n\n    noncurrent_version_expiration {\n      days = var.expiration_days\n    }\n  }\n\n  tags = {\n    Purpose = "PostApocalypticDataVault"\n  }\n}
