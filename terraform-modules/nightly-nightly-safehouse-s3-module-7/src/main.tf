terraform {\n  required_version = ">= 1.0"\n  required_providers {\n    aws = {\n      source  = "hashicorp/aws"\n      version = "~> 5.0"\n    }\n  }\n}\n\nresource "aws_s3_bucket" "safehouse" {\n  bucket        = var.bucket_name\n  force_destroy = true\n\n  versioning {\n    enabled = true\n  }\n\n  lifecycle_rule {\n    id      = "expire-old-versions"\n    enabled = true\n\n    noncurrent_version_expiration {\n      days = 30\n    }\n  }\n\n  tags = {\n    Purpose = "Post-apocalyptic safehouse storage"\n  }\n}\n
