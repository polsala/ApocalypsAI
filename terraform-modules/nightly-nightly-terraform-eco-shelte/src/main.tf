terraform {\n  required_version = ">= 1.0"\n}\n\nresource "null_resource" "shelter" {\n  triggers = {\n    shelter_name        = var.shelter_name\n    solar_capacity_kw   = var.solar_capacity_kw\n    water_tank_gallons  = var.water_tank_gallons\n  }\n\n  provisioner "local-exec" {\n    command = "echo Creating shelter ${var.shelter_name}"\n  }\n}\n\nresource "null_resource" "energy_estimate" {\n  depends_on = [null_resource.shelter]\n\n  provisioner "local-exec" {\n    command = "echo Estimated daily kWh: ${var.solar_capacity_kw * 4}"\n  }\n}\n\noutput "shelter_id" {\n  value = "shelter-${replace(var.shelter_name, \" \", \"-\")}"\n}\n\noutput "energy_production_estimate" {\n  value = var.solar_capacity_kw * 4\n}
