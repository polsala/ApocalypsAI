terraform {\n  required_providers {\n    aws = {\n      source  = "hashicorp/aws"\n      version = "~> 5.0"\n    }\n    random = {\n      source  = "hashicorp/random"\n      version = "~> 3.0"\n    }\n  }\n}\n\nresource "random_integer" "radiation_level" {\n  min = 0\n  max = 100\n}\n\nresource "aws_s3_bucket" "safehouse" {\n  bucket = var.bucket_name\n\n  tags = {\n    Name            = var.bucket_name\n    RadiationLevel = random_integer.radiation_level.result\n  }\n\n  versioning {\n    enabled = true\n  }\n\n  lifecycle_rule {\n    id      = "expire-old-objects"\n    enabled = true\n\n    expiration {\n      days = 30\n    }\n  }\n\n  server_side_encryption_configuration {\n    rule {\n      apply_server_side_encryption_by_default {\n        sse_algorithm = "AES256"\n      }\n    }\n  }\n}\n
