terraform {\n  required_version = ">= 1.0.0"\n  required_providers {\n    aws = {\n      source  = "hashicorp/aws"\n      version = "~> 5.0"\n    }\n  }\n}\n\nprovider "aws" {\n  # The AWS provider is configured via environment variables.\n  # For testing, no real credentials are needed; terraform validate works offline.\n  region = var.aws_region\n}\n\nresource "aws_s3_bucket" "safehouse" {\n  bucket = var.bucket_name\n  tags   = var.tags\n\n  versioning {\n    enabled = true\n  }\n\n  lifecycle_rule {\n    id      = "postapoc-archive"\n    enabled = true\n\n    transition {\n      days          = 30\n      storage_class = "GLACIER"\n    }\n\n    expiration {\n      days = 365\n    }\n  }\n}
