terraform {\n  required_version = ">= 1.0"\n  required_providers {\n    null = {\n      source  = "hashicorp/null"\n      version = "~> 3.2"\n    }\n  }\n}\n\nvariable "zone_name" {\n  description = "Name of the safe zone."\n  type        = string\n  default     = "Unknown Zone"\n}\n\nvariable "safety_level" {\n  description = "Safety rating from 1 (dangerous) to 10 (ultra‑safe)."\n  type        = number\n  default     = 1\n}\n\nresource "null_resource" "beacon" {\n  provisioner "local-exec" {\n    command = <<EOT\n      echo "Zone: ${var.zone_name}" > ${path.module}/beacon.txt\n      echo "Safety Level: ${var.safety_level}" >> ${path.module}/beacon.txt\n    EOT\n  }\n}\n\noutput "beacon_path" {\n  description = "Path to the generated beacon file."\n  value       = "${path.module}/beacon.txt"\n}
