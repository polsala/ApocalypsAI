terraform {\n  required_version = ">= 1.0"\n  required_providers {\n    aws = {\n      source  = "hashicorp/aws"\n      version = "~> 5.0"\n    }\n    random = {\n      source  = "hashicorp/random"\n      version = "~> 3.0"\n    }\n  }\n}\n\nresource "random_pet" "suffix" {\n  length = 2\n}\n\nresource "aws_s3_bucket" "safehouse" {\n  bucket = "${var.bucket_prefix}-${random_pet.suffix.id}"\n  force_destroy = true\n  tags = {\n    Name        = "Safehouse"\n    Environment = "PostApocalypse"\n  }\n}\n\nresource "aws_s3_bucket_versioning" "safehouse" {\n  bucket = aws_s3_bucket.safehouse.id\n  versioning_configuration {\n    status = "Enabled"\n  }\n}\n\nresource "aws_s3_bucket_server_side_encryption_configuration" "safehouse" {\n  bucket = aws_s3_bucket.safehouse.id\n  rule {\n    apply_server_side_encryption_by_default {\n      sse_algorithm = "AES256"\n    }\n  }\n}\n\nresource "aws_s3_bucket_lifecycle_configuration" "safehouse" {\n  bucket = aws_s3_bucket.safehouse.id\n  rule {\n    id     = "expire-old-objects"\n    status = "Enabled"\n    expiration {\n      days = 30\n    }\n    filter {}\n  }\n}\n
