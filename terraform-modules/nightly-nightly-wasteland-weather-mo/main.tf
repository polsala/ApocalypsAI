terraform {\n  required_providers {\n    random = {\n      source  = "hashicorp/random"\n      version = "~> 3.5"\n    }\n    local = {\n      source  = "hashicorp/local"\n      version = "~> 2.4"\n    }\n  }\n}\n\nprovider "random" {}\nprovider "local" {}\n\nvariable "location" {\n  description = "Name of the location for the forecast"\n  type        = string\n  default     = "The Wasteland"\n}\n\nvariable "seed" {\n  description = "Seed for random generator (optional)"\n  type        = number\n  default     = null\n}\n\n# Random temperature between -30 and 50 degrees Celsius\nresource "random_integer" "temperature" {\n  min  = -30\n  max  = 50\n  seed = var.seed\n}\n\n# Random weather condition\nlocals {\n  conditions = [\n    "Acid rain",\n    "Radiation storm",\n    "Dust devils",\n    "Scorching sun",\n    "Frozen fog",\n    "Mild breeze"\n  ]\n}\n\nresource "random_shuffle" "condition" {\n  input        = local.conditions\n  result_count = 1\n  seed         = var.seed\n}\n\n# Generate JSON content\nresource "local_file" "weather_json" {\n  filename = "${path.module}/weather.json"\n  content  = jsonencode({\n    location    = var.location,\n    temperature = random_integer.temperature.result,\n    condition   = random_shuffle.condition.result[0],\n    generated_at = timestamp()\n  })\n}\n
