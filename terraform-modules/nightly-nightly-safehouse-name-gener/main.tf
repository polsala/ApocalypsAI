terraform {\n  required_providers {\n    random = {\n      source  = "hashicorp/random"\n      version = "~> 3.5"\n    }\n  }\n}\n\nresource "random_pet" "name" {\n  length    = 2\n  separator = "-"\n  keepers = {\n    seed = var.prefix\n  }\n}\n\nresource "random_integer" "suffix" {\n  min = 1\n  max = 99\n  keepers = {\n    seed = var.prefix\n  }\n}\n\nlocals {\n  base_name = var.prefix != \"\" ? "${var.prefix}-${random_pet.name.id}" : random_pet.name.id\n}\n
