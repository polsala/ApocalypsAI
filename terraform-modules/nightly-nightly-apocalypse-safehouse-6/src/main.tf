terraform {\n  required_version = ">= 1.0.0"\n  required_providers {\n    aws = {\n      source  = "hashicorp/aws"\n      version = ">= 4.0"\n    }\n  }\n}\n\nprovider "aws" {\n  region = var.region\n}\n\nresource "aws_s3_bucket" "safehouse" {\n  bucket = var.bucket_name\n\n  versioning {\n    enabled = true\n  }\n\n  lifecycle_rule {\n    id      = "expire-old"\n    enabled = true\n\n    expiration {\n      days = 365\n    }\n  }\n}\n
