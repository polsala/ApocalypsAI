terraform {\n  required_version = ">= 1.0.0"\n}\n\nresource "aws_s3_bucket" "safehouse" {\n  bucket = var.bucket_name\n  tags   = var.tags\n\n  versioning {\n    enabled = true\n  }\n\n  server_side_encryption_configuration {\n    rule {\n      apply_server_side_encryption_by_default {\n        sse_algorithm = "AES256"\n      }\n    }\n  }\n\n  lifecycle_rule {\n    id      = "expire-old-objects"\n    enabled = true\n\n    expiration {\n      days = 30\n    }\n  }\n}\n
