terraform {\n  required_providers {\n    null = {\n      source  = "hashicorp/null"\n      version = "~> 3.2"\n    }\n  }\n}\n\nvariable \"supply_items\" {\n  description = \"List of scavenged items to include in the daily list.\"\n  type        = list(string)\n  default = [\n    \"canned beans\",\n    \"bottled water\",\n    \"first aid kit\",\n    \"flashlight\",\n    \"batteries\"\n  ]\n}\n\nresource \"null_resource\" \"supply_list\" {\n  triggers = {\n    items = join(",", var.supply_items)\n  }\n\n  provisioner \"local-exec\" {\n    command = <<EOT\n      echo \"Today's scavenged supplies: [${join(", ", var.supply_items)}]\" > ${path.module}/supply_list.txt\n    EOT\n  }\n}\n\noutput \"supply_file\" {\n  description = \"Path to the generated supply list file.\"\n  value       = \"${path.module}/supply_list.txt\"\n}\n
