terraform {\n  required_version = ">= 1.0"\n  required_providers {\n    aws    = { source = "hashicorp/aws", version = ">= 4.0" }\n    random = { source = "hashicorp/random", version = ">= 3.0" }\n  }\n}\n\nvariable \"bucket_name\" {\n  description = \"Name of the S3 bucket to create (must be globally unique).\"\n  type        = string\n}\n\nresource \"random_integer\" \"radiation\" {\n  min = 0\n  max = 100\n}\n\nresource \"aws_s3_bucket\" \"safehouse\" {\n  bucket = var.bucket_name\n  tags = {\n    Name            = var.bucket_name\n    Radiation_Level = random_integer.radiation.result\n  }\n}\n\nresource \"aws_s3_bucket_versioning\" \"safehouse_versioning\" {\n  bucket = aws_s3_bucket.safehouse.id\n  versioning_configuration {\n    status = \"Enabled\"\n  }\n}\n\nresource \"aws_s3_bucket_server_side_encryption_configuration\" \"safehouse_enc\" {\n  bucket = aws_s3_bucket.safehouse.id\n  rule {\n    apply_server_side_encryption_by_default {\n      sse_algorithm = \"AES256\"\n    }\n  }\n}\n\nresource \"aws_s3_bucket_lifecycle_configuration\" \"safehouse_lifecycle\" {\n  bucket = aws_s3_bucket.safehouse.id\n  rule {\n    id     = \"expire-old-objects\"\n    status = \"Enabled\"\n    filter {}\n    expiration {\n      days = 30\n    }\n  }\n}\n\noutput \"bucket_id\" {\n  description = \"The ID of the created S3 bucket.\"\n  value       = aws_s3_bucket.safehouse.id\n}\n\noutput \"radiation_level\" {\n  description = \"Randomly generated radiation level (0‑100).\"\n  value       = random_integer.radiation.result\n}\n
