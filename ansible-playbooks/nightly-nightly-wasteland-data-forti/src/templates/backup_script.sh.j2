#!/bin/bash
# Wasteland Data Archive Backup Script

SOURCE_DIR="{{ data_archive_path }}"
DEST_DIR="{{ backup_destination_path }}"
TIMESTAMP=$(date +%Y%m%d%H%M%S)
BACKUP_FILE="wasteland_archive_backup_${TIMESTAMP}.tar.gz"

echo "Starting backup of {{ data_archive_path }} to {{ backup_destination_path }}/${BACKUP_FILE}"

# Ensure destination directory exists
mkdir -p "$DEST_DIR"

# Create a compressed archive
tar -czf "${DEST_DIR}/${BACKUP_FILE}" -C "$(dirname "$SOURCE_DIR")" "$(basename "$SOURCE_DIR")"

if [ $? -eq 0 ]; then
  echo "Backup successful: ${DEST_DIR}/${BACKUP_FILE}"
else
  echo "Backup failed!"
  exit 1
fi

# Optional: Clean up old backups (e.g., keep last 7 days)
# find "$DEST_DIR" -name "wasteland_archive_backup_*.tar.gz" -mtime +7 -delete

exit 0
