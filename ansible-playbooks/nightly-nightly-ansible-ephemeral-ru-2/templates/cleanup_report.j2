<!DOCTYPE html>
<html>
<head>
    <title>GitHub Actions Runner Cleanup Report</title>
    <style>
        body { font-family: Arial, sans-serif; margin: 20px; }
        .header { background: #f0f0f0; padding: 20px; border-radius: 5px; }
        .section { margin: 20px 0; padding: 15px; border: 1px solid #ddd; border-radius: 5px; }
        .success { color: green; }
        .error { color: red; }
        .warning { color: orange; }
        table { width: 100%; border-collapse: collapse; }
        th, td { border: 1px solid #ddd; padding: 8px; text-align: left; }
        th { background-color: #f2f2f2; }
    </style>
</head>
<body>
    <div class="header">
        <h1>GitHub Actions Runner Cleanup Report</h1>
        <p><strong>Generated:</strong> {{ ansible_date_time.iso8601 }}</p>
        <p><strong>Cloud Provider:</strong> {{ cloud_provider }}</p>
        <p><strong>Organization:</strong> {{ github_org }}</p>
        <p><strong>Repository:</strong> {{ github_repo }}</p>
    </div>

    <div class="section">
        <h2>Cleanup Summary</h2>
        <p><strong>Orphaned Runners Removed:</strong> {{ orphaned_runners | length }}</p>
        <p><strong>Orphaned Instances Terminated:</strong> {{ orphaned_instances | length }}</p>
        <p><strong>Old Instances Cleaned Up:</strong> {{ old_instances | length if old_instances is defined else 0 }}</p>
    </div>

    {% if orphaned_runners | length > 0 %}
    <div class="section">
        <h2>Removed Orphaned Runners</h2>
        <table>
            <tr>
                <th>Runner Name</th>
                <th>Runner ID</th>
                <th>Reason</th>
            </tr>
            {% for runner in orphaned_runners %}
            <tr>
                <td>{{ runner }}</td>
                <td>{{ github_runners_response.json.runners | selectattr('name', 'equalto', runner) | list | first | default({}).id }}</td>
                <td>Not found in cloud provider</td>
            </tr>
            {% endfor %}
        </table>
    </div>
    {% endif %}

    {% if orphaned_instances | length > 0 %}
    <div class="section">
        <h2>Terminated Orphaned Instances</h2>
        <table>
            <tr>
                <th>Instance Name</th>
                <th>Instance ID</th>
                <th>Reason</th>
            </tr>
            {% for instance in orphaned_instances %}
            <tr>
                <td>{{ instance }}</td>
                <td>{{ cloud_instances | selectattr('name', 'equalto', instance) | list | first | default({}).id }}</td>
                <td>Not registered with GitHub</td>
            </tr>
            {% endfor %}
        </table>
    </div>
    {% endif %}

    {% if old_instances is defined and old_instances | length > 0 %}
    <div class="section">
        <h2>Old Instances Cleaned Up</h2>
        <table>
            <tr>
                <th>Instance Name</th>
                <th>Instance ID</th>
                <th>Age</th>
                <th>Reason</th>
            </tr>
            {% for instance in old_instances %}
            <tr>
                <td>{{ instance.name }}</td>
                <td>{{ instance.id }}</td>
                <td>{{ ((ansible_date_time.epoch | int - instance.launch_time | int) / 3600) | round(2) }} hours</td>
                <td>Exceeded cleanup timeout ({{ cleanup_timeout }} hours)</td>
            </tr>
            {% endfor %}
        </table>
    </div>
    {% endif %}

    <div class="section">
        <h2>Cost Savings</h2>
        <p><strong>Instances Terminated:</strong> {{ (orphaned_instances | length) + (old_instances | length if old_instances is defined else 0) }}</p>
        <p><strong>Estimated Monthly Savings:</strong> ${{ ((orphaned_instances | length) + (old_instances | length if old_instances is defined else 0)) * 20 }} (assuming $20/month per instance)</p>
        <p class="warning"><strong>Note:</strong> Actual savings may vary based on instance types and usage patterns.</p>
    </div>

    <div class="section">
        <h2>Prevention</h2>
        <p>To prevent orphaned resources in the future:</p>
        <ul>
            <li>Use the orchestrator for all runner lifecycle operations</li>
            <li>Monitor the cleanup reports regularly</li>
            <li>Set appropriate cleanup timeouts</li>
            <li>Enable queue-based scaling to match demand</li>
        </ul>
    </div>

    <div class="section">
        <h2>Next Cleanup</h2>
        <p>Run cleanup again with:</p>
        <code>ansible-playbook cleanup_runners.yml</code>
    </div>
</body>
</html>
