<!DOCTYPE html>
<html>
<head>
    <title>GitHub Actions Runner Health Report</title>
    <style>
        body { font-family: Arial, sans-serif; margin: 20px; }
        .header { background: #f0f0f0; padding: 20px; border-radius: 5px; }
        .section { margin: 20px 0; padding: 15px; border: 1px solid #ddd; border-radius: 5px; }
        .healthy { color: green; font-weight: bold; }
        .unhealthy { color: red; font-weight: bold; }
        .warning { color: orange; font-weight: bold; }
        table { width: 100%; border-collapse: collapse; }
        th, td { border: 1px solid #ddd; padding: 8px; text-align: left; }
        th { background-color: #f2f2f2; }
    </style>
</head>
<body>
    <div class="header">
        <h1>GitHub Actions Runner Health Report</h1>
        <p><strong>Generated:</strong> {{ ansible_date_time.iso8601 }}</p>
        <p><strong>Cloud Provider:</strong> {{ cloud_provider }}</p>
        <p><strong>Organization:</strong> {{ github_org }}</p>
        <p><strong>Repository:</strong> {{ github_repo }}</p>
    </div>

    <div class="section">
        <h2>Health Summary</h2>
        <p><strong>Total Runners:</strong> {{ total_runners }}</p>
        <p><strong>Healthy Runners:</strong> <span class="healthy">{{ healthy_runners }}</span></p>
        <p><strong>Unhealthy Runners:</strong> <span class="unhealthy">{{ total_runners | int - healthy_runners | int }}</span></p>
        <p><strong>Health Percentage:</strong> {{ (healthy_runners | float / total_runners | float * 100) | round(2) }}%</p>
    </div>

    <div class="section">
        <h2>Runner Details</h2>
        <table>
            <tr>
                <th>Runner Name</th>
                <th>Service Status</th>
                <th>GitHub Registration</th>
                <th>System Load</th>
                <th>Health Status</th>
            </tr>
            {% for host in groups['runners'] %}
            {% set facts = hostvars[host] %}
            <tr>
                <td>{{ facts.runner_name if facts.runner_name is defined else host }}</td>
                <td>{% if facts.health_status == 'healthy' %}<span class="healthy">Running</span>{% else %}<span class="unhealthy">Failed</span>{% endif %}</td>
                <td>{% if facts.runner_registered | default(false) %}<span class="healthy">Registered</span>{% else %}<span class="unhealthy">Not Registered</span>{% endif %}</td>
                <td>{{ facts.system_status.stdout_lines | join(', ') if facts.system_status is defined else 'N/A' }}</td>
                <td>{% if facts.health_status == 'healthy' %}<span class="healthy">Healthy</span>{% else %}<span class="unhealthy">Unhealthy</span>{% endif %}</td>
            </tr>
            {% endfor %}
        </table>
    </div>

    <div class="section">
        <h2>Recommendations</h2>
        {% if (total_runners | int - healthy_runners | int) > 0 %}
        <p class="warning">Some runners are unhealthy. Consider:</p>
        <ul>
            <li>Restarting failed runner services</li>
            <li>Re-registering unregistered runners</li>
            <li>Investigating system resource issues</li>
            <li>Scaling up if healthy runner count is insufficient</li>
        </ul>
        {% else %}
        <p class="healthy">All runners are healthy! No immediate action required.</p>
        {% endif %}
    </div>

    <div class="section">
        <h2>Next Health Check</h2>
        <p>Run the health check again in {{ health_check_interval }} seconds:</p>
        <code>ansible-playbook health_check.yml</code>
    </div>
</body>
</html>
