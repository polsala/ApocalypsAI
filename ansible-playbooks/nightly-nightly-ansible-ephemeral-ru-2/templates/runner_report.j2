<!DOCTYPE html>
<html>
<head>
    <title>GitHub Actions Runner Report</title>
    <style>
        body { font-family: Arial, sans-serif; margin: 20px; }
        .header { background: #f0f0f0; padding: 20px; border-radius: 5px; }
        .section { margin: 20px 0; padding: 15px; border: 1px solid #ddd; border-radius: 5px; }
        .success { color: green; }
        .error { color: red; }
        .warning { color: orange; }
        table { width: 100%; border-collapse: collapse; }
        th, td { border: 1px solid #ddd; padding: 8px; text-align: left; }
        th { background-color: #f2f2f2; }
    </style>
</head>
<body>
    <div class="header">
        <h1>GitHub Actions Runner Orchestration Report</h1>
        <p><strong>Generated:</strong> {{ ansible_date_time.iso8601 }}</p>
        <p><strong>Cloud Provider:</strong> {{ cloud_provider }}</p>
        <p><strong>Organization:</strong> {{ github_org }}</p>
        <p><strong>Repository:</strong> {{ github_repo }}</p>
    </div>

    <div class="section">
        <h2>Scaling Summary</h2>
        <p><strong>Current Runners:</strong> {{ current_runners }}</p>
        <p><strong>Required Runners:</strong> {{ required_runners }}</p>
        <p><strong>Scaling Action:</strong> {% if scale_up %}Scale Up{% elif scale_down %}Scale Down{% else %}No Change{% endif %}</p>
        <p><strong>Scale Amount:</strong> {{ scale_amount }}</p>
    </div>

    {% if new_runner_instances is defined %}
    <div class="section">
        <h2>New Runners Provisioned</h2>
        <table>
            <tr>
                <th>Instance ID</th>
                <th>Name</th>
                <th>Public IP</th>
                <th>Status</th>
                <th>Launch Time</th>
            </tr>
            {% for instance in new_runner_instances %}
            <tr>
                <td>{{ instance.id }}</td>
                <td>{{ instance.tags.Name if cloud_provider == 'aws' else instance.name }}</td>
                <td>{{ instance.public_ip_address if cloud_provider == 'aws' else instance.network_interfaces[0].access_configs[0].nat_ip }}</td>
                <td class="success">Provisioned</td>
                <td>{{ instance.launch_time if cloud_provider == 'aws' else instance.time_created }}</td>
            </tr>
            {% endfor %}
        </table>
    </div>
    {% endif %}

    <div class="section">
        <h2>Configuration</h2>
        <p><strong>Max Runners:</strong> {{ max_runners }}</p>
        <p><strong>Min Runners:</strong> {{ min_runners }}</p>
        <p><strong>Health Check Interval:</strong> {{ health_check_interval }} seconds</p>
        <p><strong>Cleanup Timeout:</strong> {{ cleanup_timeout }} hours</p>
        <p><strong>Queue Check Enabled:</strong> {{ enable_queue_check }}</p>
    </div>

    <div class="section">
        <h2>Next Steps</h2>
        <ul>
            <li>Monitor runner health with: <code>ansible-playbook health_check.yml</code></li>
            <li>Cleanup orphaned resources with: <code>ansible-playbook cleanup_runners.yml</code></li>
            <li>Review logs for any provisioning errors</li>
        </ul>
    </div>

    <div class="section">
        <p class="warning"><strong>Note:</strong> This is an automated report. Please review the orchestration output for any errors or warnings.</p>
    </div>
</body>
</html>
