<!DOCTYPE html>
<html>
<head>
    <title>Ansible Playbook Validation Report</title>
    <style>
        body { font-family: Arial, sans-serif; margin: 20px; }
        .header { background: #f0f0f0; padding: 20px; border-radius: 5px; }
        .section { margin: 20px 0; padding: 15px; border: 1px solid #ddd; border-radius: 5px; }
        .passed { background: #d4edda; border-color: #c3e6cb; }
        .failed { background: #f8d7da; border-color: #f5c6cb; }
        .warning { background: #fff3cd; border-color: #ffeaa7; }
        table { width: 100%; border-collapse: collapse; }
        th, td { border: 1px solid #ddd; padding: 8px; text-align: left; }
        th { background-color: #f2f2f2; }
        .code { background: #f8f9fa; padding: 10px; border-radius: 3px; font-family: monospace; }
    </style>
</head>
<body>
    <div class="header">
        <h1>Ansible Playbook Validation Report</h1>
        <p><strong>Generated:</strong> {{ ansible_date_time.iso8601 }}</p>
        <p><strong>Playbook:</strong> {{ playbook_to_validate | default('N/A') }}</p>
        <p><strong>Ansible Version:</strong> {{ ansible_version.stdout_lines[0] }}</p>
    </div>

    <div class="section {% if validation_results.syntax_check.status %}passed{% else %}failed{% endif %}">
        <h2>Syntax Validation</h2>
        <p><strong>Status:</strong> {{ 'PASSED' if validation_results.syntax_check.status else 'FAILED' }}</p>
        {% if validation_results.syntax_check.output %}
        <div class="code">
            <h3>Output:</h3>
            <pre>{{ validation_results.syntax_check.output }}</pre>
        </div>
        {% endif %}
        {% if validation_results.syntax_check.errors %}
        <div class="code">
            <h3>Errors:</h3>
            <pre>{{ validation_results.syntax_check.errors }}</pre>
        </div>
        {% endif %}
    </div>

    <div class="section {% if validation_results.lint_check.status %}passed{% else %}failed{% endif %}">
        <h2>Lint Validation</h2>
        <p><strong>Status:</strong> {{ 'PASSED' if validation_results.lint_check.status else 'FAILED' }}</p>
        <p><strong>Violations:</strong> {{ validation_results.lint_check.violations | default(0) }}</p>
        {% if validation_results.lint_check.details %}
        <table>
            <thead>
                <tr>
                    <th>Rule</th>
                    <th>File</th>
                    <th>Line</th>
                    <th>Message</th>
                </tr>
            </thead>
            <tbody>
                {% for violation in validation_results.lint_check.details %}
                <tr>
                    <td>{{ violation.rule or 'N/A' }}</td>
                    <td>{{ violation.file or 'N/A' }}</td>
                    <td>{{ violation.line or 'N/A' }}</td>
                    <td>{{ violation.message or 'N/A' }}</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
        {% endif %}
    </div>

    {% if validation_settings.check_idempotency | bool %}
    <div class="section {% if validation_results.idempotency_check.status %}passed{% else %}failed{% endif %}">
        <h2>Idempotency Test</h2>
        <p><strong>Status:</strong> {{ 'PASSED' if validation_results.idempotency_check.status else 'FAILED' }}</p>
        <div class="code">
            <h3>Check Mode Output:</h3>
            <pre>{{ validation_results.idempotency_check.check_output }}</pre>
        </div>
        <div class="code">
            <h3>Normal Run Output:</h3>
            <pre>{{ validation_results.idempotency_check.normal_output }}</pre>
        </div>
        {% if validation_results.idempotency_check.check_errors %}
        <div class="code">
            <h3>Check Mode Errors:</h3>
            <pre>{{ validation_results.idempotency_check.check_errors }}</pre>
        </div>
        {% endif %}
        {% if validation_results.idempotency_check.normal_errors %}
        <div class="code">
            <h3>Normal Run Errors:</h3>
            <pre>{{ validation_results.idempotency_check.normal_errors }}</pre>
        </div>
        {% endif %}
    </div>
    {% endif %}

    <div class="section">
        <h2>Overall Summary</h2>
        <p><strong>Syntax Check:</strong> {{ 'PASSED' if validation_results.syntax_check.status else 'FAILED' }}</p>
        <p><strong>Lint Check:</strong> {{ 'PASSED' if validation_results.lint_check.status else 'FAILED' }}</p>
        {% if validation_settings.check_idempotency | bool %}
        <p><strong>Idempotency:</strong> {{ 'PASSED' if validation_results.idempotency_check.status else 'FAILED' }}</p>
        {% endif %}
        <p><strong>Validation Date:</strong> {{ ansible_date_time.iso8601 }}</p>
    </div>
</body>
</html>
