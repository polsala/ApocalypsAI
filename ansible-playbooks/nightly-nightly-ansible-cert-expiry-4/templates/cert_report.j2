<!DOCTYPE html>
<html>
<head>
  <title>Certificate Expiry Report</title>
  <style>
    body { font-family: Arial, sans-serif; }
    table { border-collapse: collapse; width: 100%; }
    th, td { border: 1px solid #ddd; padding: 8px; }
    th { background-color: #f2f2f2; }
    .expiring { background-color: #ffdddd; }
    .valid { background-color: #ddffdd; }
    .unknown { background-color: #ffffcc; }
  </style>
</head>
<body>
  <h1>Certificate Expiry Report</h1>
  <table>
    <tr>
      <th>Host</th>
      <th>Expiry Date</th>
      <th>Status</th>
    </tr>
    {% for cert in cert_results | default([]) %}
    <tr class="{{ cert.status | lower | replace(' ', '-') }}">
      <td>{{ cert.host }}</td>
      <td>{{ cert.expiry }}</td>
      <td>{{ cert.status }}</td>
    </tr>
    {% endfor %}
  </table>
</body>
</html>
