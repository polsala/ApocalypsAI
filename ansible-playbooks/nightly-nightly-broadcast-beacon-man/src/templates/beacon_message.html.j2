<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ beacon_message_title }}</title>
    <style>
        body { font-family: monospace; background-color: #1a1a1a; color: #00ff00; margin: 2em; }
        h1 { color: #ffcc00; }
        pre { white-space: pre-wrap; word-wrap: break-word; border: 1px solid #00ff00; padding: 1em; }
        .footer { font-size: 0.8em; color: #888; margin-top: 2em; }
    </style>
</head>
<body>
    <h1>{{ beacon_message_title }}</h1>
    <pre>{{ beacon_message_content }}</pre>
    <p class="footer">{{ beacon_message_footer }}</p>
</body>
</html>
