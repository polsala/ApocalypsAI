#!/bin/bash
# This script is generated by the Nightly Server Cheer-Up Agent.
# It displays a random fortune message using cowsay upon login.

# Check if cowsay and fortune are installed before attempting to run
{% if cheer_up_enable_fortune and cheer_up_enable_cowsay %}
if command -v fortune &> /dev/null && command -v cowsay &> /dev/null; then
  fortune | cowsay
fi
{% elif cheer_up_enable_fortune %}
if command -v fortune &> /dev/null; then
  fortune
fi
{% elif cheer_up_enable_cowsay %}
if command -v cowsay &> /dev/null; then
  echo "Moo! (Cowsay is installed, but fortune is not enabled or found.)" | cowsay
fi
{% else %}
# No cheer-up enabled.
{% endif %}

{% if cheer_up_deploy_ascii_art %}
# Display custom ASCII art
if [ -f "{{ cheer_up_custom_ascii_art_path }}" ]; then
  cat "{{ cheer_up_custom_ascii_art_path }}"
fi
{% endif %}
