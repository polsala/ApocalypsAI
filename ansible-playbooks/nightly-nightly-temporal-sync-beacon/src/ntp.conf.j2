# This file is managed by Ansible. Do not edit manually.

{% for server in ntp_servers %}
server {{ server }} iburst
{% endfor %}

# Undisciplined Local Clock. This is a fake driver intended for backup
# and when no outside source of time is available.
# server  127.127.1.0 # local clock
# fudge   127.127.1.0 stratum 10

# Drift file.  Stores the system clock drift rate.
driftfile /var/lib/ntp/ntp.drift

# Permit time synchronization with our peers, but do not allow configuration.
restrict default kod nomodify notrap nopeer noquery

# Permit all access over the loopback interface.
restrict 127.0.0.1
restrict ::1

# Permit peers to synchronize with this NTP server.
# restrict 192.168.0.0 mask 255.255.0.0 nomodify notrap
