# /etc/ntp.conf managed by Ansible
{% for server in ntp_servers %}
server {{ server }} iburst
{% endfor %}

# Drift file.  Stores the system clock's rate drift.
driftfile /var/lib/ntp/ntp.drift

# Permit time synchronization with our peers, but do not allow them to modify the
# system's configuration.
restrict default kod nomodify notrap nopeer noquery
restrict -6 default kod nomodify notrap nopeer noquery

# Permit all access over the loopback interface.
restrict 127.0.0.1
restrict -6 ::1

# For more information see ntp.conf(5) and the /usr/share/doc/ntp-doc/html/
# documentation.
