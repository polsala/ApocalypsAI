<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Chaos Engineering Report - {{ ansible_date_time.iso8601 }}</title>
    <style>
        body {
            font-family: 'Courier New', monospace;
            background: #1a1a1a;
            color: #00ff00;
            margin: 0;
            padding: 20px;
        }
        .container {
            max-width: 800px;
            margin: 0 auto;
            background: #000;
            border: 2px solid #00ff00;
            padding: 20px;
            box-shadow: 0 0 20px rgba(0, 255, 0, 0.1);
        }
        h1 {
            text-align: center;
            color: #ff0000;
            text-transform: uppercase;
            border-bottom: 2px solid #00ff00;
            padding-bottom: 10px;
        }
        .header-info {
            background: #333;
            padding: 15px;
            margin: 20px 0;
            border-left: 4px solid #00ff00;
        }
        .chaos-event {
            background: #222;
            padding: 15px;
            margin: 10px 0;
            border: 1px solid #333;
            border-left: 4px solid #ff0000;
        }
        .chaos-event.success {
            border-left-color: #00ff00;
        }
        .chaos-event.warning {
            border-left-color: #ffff00;
        }
        .chaos-event.error {
            border-left-color: #ff0000;
        }
        .timestamp {
            color: #888;
            font-size: 0.9em;
        }
        .footer {
            text-align: center;
            margin-top: 30px;
            color: #888;
            font-size: 0.8em;
        }
        .matrix-bg {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: repeating-linear-gradient(
                0deg,
                rgba(0, 255, 0, 0.1),
                rgba(0, 255, 0, 0.1) 1px,
                transparent 1px,
                transparent 2px
            );
            pointer-events: none;
            z-index: -1;
        }
    </style>
</head>
<body>
    <div class="matrix-bg"></div>
    <div class="container">
        <h1>chaos engineering report</h1>
        
        <div class="header-info">
            <strong>Target:</strong> {{ inventory_hostname }}<br>
            <strong>Start Time:</strong> {{ ansible_date_time.iso8601 }}<br>
            <strong>Duration:</strong> {{ (ansible_date_time.epoch | int - chaos_start_time | int) }} seconds<br>
            <strong>Status:</strong> <span style="color: #00ff00;">CHAOS COMPLETE</span>
        </div>

        <h2>chaos scenarios applied:</h2>
        
        {% for line in lookup('file', chaos_report_file).splitlines() %}
            {% if line.startswith('- ') %}
                <div class="chaos-event">
                    <div class="timestamp">{{ ansible_date_time.iso8601 }}</div>
                    <div>{{ line[2:] }}</div>
                </div>
            {% endif %}
        {% endfor %}

        <div class="chaos-event success">
            <div class="timestamp">{{ ansible_date_time.iso8601 }}</div>
            <div><strong>Cleanup:</strong> All chaos artifacts removed successfully</div>
        </div>

        <div class="footer">
            Generated by Nightly Chaos Orchestrator v1.0<br>
            "Embrace the chaos, but leave no trace"
        </div>
    </div>
</body>
</html>
